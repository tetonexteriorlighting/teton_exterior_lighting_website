---
import Layout from '../layouts/Layout.astro';
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const looks = [
  { src: '/images/seasonal-christmas-lights-multicolor-snowy-ranch.jpg', alt: 'Multicolor traditional Christmas lights on ranch home roofline in fresh snow', title: 'Multicolor Classic', body: 'Every color, all at once. The look most people picture when they think Christmas.' },
  { src: '/images/seasonal-christmas-lights-red-white-classic-home.jpg', alt: 'Red and white traditional Christmas lights outlining roofline and windows', title: 'Red & White', body: 'Lights along the roofline and outlining the windows for a fully dressed-up look.' },
  { src: '/images/seasonal-christmas-lights-warm-white-modern-home.jpg', alt: 'Warm white traditional Christmas lights on modern home roofline', title: 'Warm White', body: 'Clean and elegant, this is the most requested look for a reason.' },
  { src: '/images/seasonal-christmas-lights-teal-red-modern-farmhouse.jpg', alt: 'Teal and red traditional Christmas lights on modern farmhouse roofline', title: 'Teal & Red', body: 'A modern twist on tradition for homeowners who want something different.' },
  { src: '/images/seasonal-christmas-lights-multicolor-craftsman-snow.jpg', alt: 'Multicolor traditional Christmas lights on large two-story craftsman home in snow', title: 'Full Multicolor Wrap', body: 'Gables, balcony, and roofline, all lit up for the biggest homes on the block.' },
  { src: '/images/seasonal-christmas-lights-warm-white-luxury-snow.jpg', alt: 'Warm white traditional Christmas lights on large luxury home in snow', title: 'Warm White Estate', body: 'Understated and upscale, built for homes that don\'t need to shout.' },
  { src: '/images/seasonal-christmas-lights-red-gold-classic-gables.jpg', alt: 'Red and gold traditional Christmas lights along home gables', title: 'Red & Gold', body: 'A warmer take on the classic red and white look.' },
];
---

<Layout
  title="Seasonal Christmas Lighting | Teton Exterior Lighting | Idaho Falls, ID"
  description="Professional Christmas light installation and removal for Idaho Falls homes. We hang it in the fall and take it down in January or February, no ladders, no storage, no hassle."
>
  <Nav />

  <!-- ===================================================
       HERO
  =================================================== -->
  <section class="seasonal-hero" id="seasonal-hero">
    <div class="seasonal-hero-bg" aria-hidden="true"></div>
    <div class="seasonal-hero-overlay" aria-hidden="true"></div>
    <div class="container seasonal-hero-content">
      <span class="eyebrow">Seasonal Christmas Lighting · Idaho Falls &amp; the Surrounding Region</span>
      <h1 class="section-title">Christmas Lights, <span class="gold">Hung and Taken Down for You</span></h1>
      <p class="section-body">
        We install professional-grade Christmas lights on your home starting in September, and take them
        down again in January or February, whichever you prefer. No ladders, no storage bins, no hassle.
        Just a beautifully lit home for the season.
      </p>
      <div class="hero-ctas">
        <a href="/contact" class="btn btn-gold btn-lg">Get My Free Quote</a>
        <a href="#looks" class="btn btn-outline btn-lg">See the Looks</a>
      </div>
    </div>
  </section>

  <!-- ===================================================
       WHAT'S INCLUDED
  =================================================== -->
  <section class="included-section" id="included">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow center">Fully Done for You</span>
        <div class="gold-rule center"></div>
        <h2 class="section-title" style="text-align:center">What's Included</h2>
      </div>
      <div class="why-grid">
        {[
          { icon: '🪜', title: 'Professional Installation', body: 'Our crew installs premium string lights along your roofline, eaves, and gables. No ladders for you, ever.' },
          { icon: '🎨', title: 'Your Choice of Color', body: 'Classic red and green, warm white, full multicolor, or a custom mix. Whatever fits your home.' },
          { icon: '📦', title: 'Nothing to Store', body: 'These aren\'t your lights to keep in a bin all year. We bring them, we install them, we take them back.' },
          { icon: '🧹', title: 'Full Removal Included', body: 'When the season\'s over, we come back and take everything down. You choose January or February.' },
        ].map(c => (
          <div class="why-card reveal">
            <div class="why-icon">{c.icon}</div>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================
       TIMELINE BANNER
  =================================================== -->
  <section class="urgency-banner">
    <div class="container urgency-inner reveal">
      <span class="urgency-icon">🎄</span>
      <p>
        <strong>We install starting in September and are lit up well before December.</strong>
        Book early and skip the holiday-season waitlist entirely. Removal happens on your schedule,
        January or February, your call.
      </p>
    </div>
  </section>

  <!-- ===================================================
       LOOKS GALLERY
  =================================================== -->
  <section class="looks-section" id="looks">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow center">Real Homes, Real Installs</span>
        <div class="gold-rule center"></div>
        <h2 class="section-title" style="text-align:center">Pick Your Christmas Look</h2>
        <p class="section-body center" style="margin-top:0.5rem">
          Every install below was hung by our crew for a real customer this season.
        </p>
      </div>
      <div class="looks-grid">
        {looks.map(l => (
          <div class="look-card reveal">
            <div class="look-img-wrap">
              <img src={l.src} alt={l.alt} loading="lazy" />
            </div>
            <div class="look-body">
              <h3>{l.title}</h3>
              <p>{l.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================
       WHY PROFESSIONAL INSTALL
  =================================================== -->
  <section class="why-pro-section">
    <div class="container why-pro-inner">
      <div class="why-pro-text reveal">
        <span class="eyebrow">Why Not Just DIY?</span>
        <div class="gold-rule"></div>
        <h2 class="section-title">Leave the Ladder<br />to Us</h2>
        <p class="section-body">
          Every December, someone falls off a ladder hanging Christmas lights. We've built our whole
          process around making sure that's never you.
        </p>
        <p class="section-body" style="margin-top:0.75rem">
          Our crew works safely at height in cold weather, every day, all season. We use commercial-grade
          lights that hold up in real Idaho winters instead of the box-store strands that go dark by
          New Year's. And when the season's over, we handle takedown too, so there's nothing left for you
          to climb up and untangle in January.
        </p>
      </div>
      <div class="why-pro-image reveal">
        <img src="/images/seasonal-christmas-lights-red-gold-stone-home.jpg" alt="Red and gold traditional Christmas lights professionally installed on stone home roofline at dusk" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ===================================================
       REVIEWS
  =================================================== -->
  <section class="seasonal-reviews">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow center">What Homeowners Are Saying</span>
        <div class="gold-rule center"></div>
        <h2 class="section-title" style="text-align:center">Trusted Across Idaho Falls</h2>
        <a href="https://www.google.com/maps?cid=8379863443859849851" target="_blank" rel="noopener" class="google-rating-link">
          ⭐⭐⭐⭐⭐ 5.0 rating · 46 Google Reviews
        </a>
      </div>
      <div class="testi-grid">
        {[
          { initial: 'M', name: 'Mantis Sebastian', quote: 'Teton Exterior Lighting did an outstanding job on our home. Clean, professional, and completely transformed the exterior.' },
          { initial: 'M', name: 'Mark Bodily', quote: 'Awesome lighting. Service is top notch! They have a great product and are extremely knowledgeable and customer oriented.' },
        ].map(t => (
          <div class="testi-card reveal">
            <div class="stars">⭐⭐⭐⭐⭐</div>
            <p class="quote">"{t.quote}"</p>
            <div class="testi-author">
              <div class="avatar">{t.initial}</div>
              <div><strong>{t.name}</strong></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================
       FAQ
  =================================================== -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow center">Common Questions</span>
        <div class="gold-rule center"></div>
        <h2 class="section-title" style="text-align:center">Seasonal Lighting FAQ</h2>
      </div>
      <div class="faq-list">
        {[
          { q: 'How is this different from your permanent lighting?', a: 'This is a traditional seasonal service: we hang string lights in the fall and remove them in January or February. Our <a href="/holiday-lighting">permanent LED system</a> is a separate, year-round installation that stays up and gets reprogrammed for every occasion. If you\'re not sure which fits your home, just ask when you request a quote.' },
          { q: 'When do you take the lights down?', a: 'Whenever you\'d like, January or February. Just let us know your preference and we\'ll get it on the schedule.' },
          { q: 'Do I need to buy or store any lights myself?', a: 'No. We bring commercial-grade lights, install them, and take them back down. There\'s nothing for you to purchase, store, or untangle.' },
          { q: 'Do you do commercial properties too?', a: 'Yes. We\'ve lit up local businesses right alongside homes, from clinics to community buildings, using the same professional installation and full removal service.' },
        ].map(f => (
          <div class="faq-item reveal">
            <h3>{f.q}</h3>
            <p set:html={f.a} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================
       FINAL CTA
  =================================================== -->
  <section class="seasonal-cta">
    <div class="container cta-inner reveal">
      <div class="cta-text">
        <h2>Ready for Your Home to Be Lit Up?</h2>
        <p>Free quote. No obligation. Book now and skip the holiday-season waitlist.</p>
      </div>
      <a href="/contact" class="btn btn-gold btn-lg">Get My Free Quote →</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ---- Hero ---- */
  .seasonal-hero {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .seasonal-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/seasonal-christmas-lights-warm-white-golden-dusk.jpg');
    background-size: cover;
    background-position: center 60%;
  }
  .seasonal-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(8,8,8,0.90) 0%, rgba(8,8,8,0.55) 100%);
  }
  .seasonal-hero-content {
    position: relative;
    z-index: 2;
    padding: 160px 24px 90px;
    max-width: 760px;
  }
  .seasonal-hero-content .section-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-bottom: 1.25rem;
  }
  .seasonal-hero-content .gold { color: var(--accent); }
  .seasonal-hero-content .section-body { max-width: 620px; }
  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* ---- Included grid ---- */
  .included-section { background: var(--surface); padding: var(--section-pad); }
  .section-header { margin-bottom: 3.5rem; }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .why-card {
    background: var(--surface3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    transition: all var(--transition);
  }
  .why-card:hover { border-color: var(--border-gold); transform: translateY(-3px); }
  .why-icon { font-size: 2rem; margin-bottom: 0.75rem; }
  .why-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem; }
  .why-card p { font-size: 0.9rem; color: var(--silver); line-height: 1.7; }

  /* ---- Urgency banner ---- */
  .urgency-banner {
    background: var(--surface3);
    border-top: 1px solid var(--border-gold);
    border-bottom: 1px solid var(--border-gold);
    padding: 1.75rem 0;
  }
  .urgency-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
    text-align: left;
  }
  .urgency-icon { font-size: 1.8rem; flex-shrink: 0; }
  .urgency-inner p { font-size: 0.95rem; color: var(--silver); line-height: 1.6; }
  .urgency-inner strong { color: var(--white); }

  /* ---- Looks gallery ---- */
  .looks-section { background: var(--surface2); padding: var(--section-pad); }
  .looks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .look-card {
    background: var(--surface3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition);
  }
  .look-card:hover { border-color: var(--border-gold); transform: translateY(-4px); }
  .look-img-wrap { aspect-ratio: 4 / 3; overflow: hidden; }
  .look-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .look-body { padding: 1.5rem; }
  .look-body h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.4rem; }
  .look-body p { font-size: 0.88rem; color: var(--silver); line-height: 1.6; }

  /* ---- Why pro install ---- */
  .why-pro-section { background: var(--surface); padding: var(--section-pad); }
  .why-pro-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .why-pro-image img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px rgba(0,0,0,0.4);
  }

  /* ---- Reviews (matches homepage testimonials) ---- */
  .seasonal-reviews { background: var(--surface2); padding: var(--section-pad); }
  .google-rating-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--silver);
    text-decoration: none;
  }
  .google-rating-link:hover { color: var(--accent); }
  .testi-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .testi-card {
    background: var(--surface3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
  }
  .testi-card .stars { margin-bottom: 0.75rem; }
  .testi-card .quote { font-size: 0.92rem; color: var(--silver); line-height: 1.7; margin-bottom: 1.25rem; }
  .testi-author { display: flex; align-items: center; gap: 0.75rem; }
  .avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--surface);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* ---- FAQ ---- */
  .faq-section { background: var(--surface); padding: var(--section-pad); }
  .faq-list {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .faq-item {
    background: var(--surface3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
  }
  .faq-item h3 { font-size: 1.02rem; font-weight: 700; margin-bottom: 0.5rem; }
  .faq-item p { font-size: 0.9rem; color: var(--silver); line-height: 1.7; }
  .faq-item p a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .faq-item p a:hover { color: var(--accent-bright); }

  /* ---- Final CTA ---- */
  .seasonal-cta { background: var(--surface2); padding: var(--section-pad); }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    background: var(--surface3);
    border: 1px solid var(--border-gold);
    border-radius: var(--radius-lg);
    padding: 3rem;
  }
  .cta-text h2 { font-size: 1.6rem; margin-bottom: 0.5rem; }
  .cta-text p { color: var(--silver); font-size: 0.95rem; }

  @media (max-width: 1024px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
    .looks-grid { grid-template-columns: repeat(2, 1fr); }
    .why-pro-inner { grid-template-columns: 1fr; gap: 3rem; }
  }

  @media (max-width: 768px) {
    .why-grid { grid-template-columns: 1fr; }
    .looks-grid { grid-template-columns: 1fr; }
    .testi-grid { grid-template-columns: 1fr; }
    .cta-inner { flex-direction: column; text-align: center; }
  }
</style>
