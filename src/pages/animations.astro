---
import Layout from '../layouts/Layout.astro';
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Lighting Animations & Effects | Teton Exterior Lighting"
  description="Browse all 153 ShowHome lighting effects available with your permanent LED system. Every animation shown live. App-controlled from your phone."
>
  <Nav />

  <!-- ═══════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════ -->
  <section class="anim-hero">
    <div class="container anim-hero-inner">
      <span class="eyebrow center">App-Controlled Effects</span>
      <div class="gold-rule center"></div>
      <h1 class="section-title" style="text-align:center">153 Lighting Effects</h1>
      <p class="section-body center" style="max-width:560px;margin:0.75rem auto 2rem">
        Every animation built into the ShowHome app — all on your phone. Change your home's entire look
        in seconds. Browse the full library below.
      </p>
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input type="search" id="fxSearch" class="fx-search" placeholder="Search effects…" autocomplete="off" />
        <span id="searchCount" class="search-count"></span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       GRID
  ═══════════════════════════════════════════════════════ -->
  <section class="grid-section">
    <div class="container">
      <div id="effectsGrid" class="effects-grid"></div>
      <p id="noResults" class="no-results" style="display:none">No effects match — try a different name.</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       CTA
  ═══════════════════════════════════════════════════════ -->
  <section class="anim-cta">
    <div class="container anim-cta-inner">
      <div>
        <h2>All 153 Effects. One App.</h2>
        <p>Change your home's look in seconds from anywhere in the world. Get your permanent LED system installed today.</p>
      </div>
      <a href="/contact" class="btn btn-gold btn-lg">Get My Free Quote →</a>
    </div>
  </section>

  <Footer />
</Layout>

