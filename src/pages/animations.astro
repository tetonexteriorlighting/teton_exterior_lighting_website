// ─── Canvas & house geometry ─────────────────────────────────────────────────
const CW = 220, CH = 92;          // logical canvas pixels
const N  = 26;                     // LEDs along roofline
const EAVE_Y  = CH * 0.46;        // ~42 — where roof meets wall
const PEAK_Y  = CH * 0.04;        // ~4  — roof peak
const PEAK_X  = CW / 2;           // 110
const EAVE_LX = CW * 0.01;        // ~2
const EAVE_RX = CW * 0.99;        // ~218
const WALL_LX = CW * 0.08;        // ~18
const WALL_RX = CW * 0.92;        // ~202
const LED_STEP = (EAVE_RX - EAVE_LX) / (N - 1);

// ─── LED type ─────────────────────────────────────────────────────────────────
type LED = { r: number; g: number; b: number; a: number };

// ─── Canvas state ─────────────────────────────────────────────────────────────
interface State { type: string; hue: number; leds: LED[]; dpr: number }
const states  = new Map<HTMLCanvasElement, State>();
const visible = new Set<HTMLCanvasElement>();

// ─── HSL → RGB ────────────────────────────────────────────────────────────────
function hsl(h: number, s: number, l: number): [number, number, number] {
  h = ((h % 360) + 360) % 360;
  s /= 100; l /= 100;
  const c = (1 - Math.abs(2 * l - 1)) * s;
  const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
  const m = l - c / 2;
  let r = 0, g = 0, b = 0;
  if      (h < 60)  { r = c; g = x; b = 0; }
  else if (h < 120) { r = x; g = c; b = 0; }
  else if (h < 180) { r = 0; g = c; b = x; }
  else if (h < 240) { r = 0; g = x; b = c; }
  else if (h < 300) { r = x; g = 0; b = c; }
  else              { r = c; g = 0; b = x; }
  return [Math.round((r + m) * 255), Math.round((g + m) * 255), Math.round((b + m) * 255)];
}
function clamp(v: number) { return Math.max(0, Math.min(255, v)); }

// ─── Animation type lookup ────────────────────────────────────────────────────
function getAnimType(name: string): string {
  const n = name.toLowerCase().trim();

  // Solid
  if (/^solid \d+$/.test(n)) return 'solid';
  if (n === 'solid pattern')       return 'solid_pattern';
  if (n === 'solid pattern tri')   return 'tri';
  if (n === 'solid glitter')       return 'sparkle';

  // Breathe / fade
  if (n === 'breathe' || n === 'fade' || n === 'sunrise') return 'breathe';
  if (n === 'heartbeat')           return 'heartbeat';
  if (n === 'percent')             return 'sweep';

  // Blink
  if (n === 'blink' || n === 'blink rainbow' || n === 'pulse train') return 'blink';
  if (n === 'traffic light')       return 'traffic';
  if (n === 'tv simulator')        return 'blink';

  // Strobe
  if (n === 'strobe' || n === 'strobe mega' || n === 'strobe rainbow') return 'strobe';
  if (n === 'lightning' || n === 'dj light') return 'strobe';

  // Fire / candle
  if (n === 'fire 2012' || n === 'noisefire' || n === 'fire flicker') return 'fire';
  if (n === 'candle' || n === 'candle multi') return 'candle';

  // Sparkle / glitter / fireworks / rain
  if (n === 'sparkle' || n === 'sparkle dark' || n === 'sparkle+' || n === 'glitter') return 'sparkle';
  if (n === 'fireworks' || n === 'fireworks starburst' || n === 'fireworks 1d') return 'sparkle';
  if (n === 'rain' || n === 'popcorn') return 'sparkle';

  // Twinkle
  if (n === 'twinkle' || n === 'twinklefox' || n === 'twinklecat' || n === 'twinkleup') return 'twinkle';
  if (n === 'fairy' || n === 'fairytwinkle' || n === 'colortwinkles') return 'twinkle';

  // Dissolve
  if (n === 'dissolve' || n === 'dissolve rnd' || n === 'sweep random') return 'dissolve';

  // Meteor / drip
  if (n === 'meteor' || n === 'meteor smooth' || n === 'drip') return 'meteor';

  // Running comets
  if (n === 'multi comet' || n === 'chase tail' || n === 'glints') return 'running';

  // Rainbow variants
  if (n === 'rainbow' || n === 'rainbow runner' || n === 'pride 2015') return 'rainbow';
  if (n === 'theater rainbow' || n === 'sinelon rainbow') return 'rainbow';
  if (n === 'chase rainbow') return 'rainbow_chase';

  // Theater (marquee)
  if (n === 'theater') return 'theater';

  // Chase variants — each maps to a visually distinct function
  if (n === 'chase' || n === 'chase 3' || n === 'chase 4' || n === 'chase 5') return 'chase';
  if (n === 'chase flash') return 'chase_flash';
  if (n === 'chase flash rnd') return 'sparkle';
  if (n === 'chase random') return 'stream';    // multi-dot, variable speed
  if (n === 'chase 2') return 'meteor';         // longer, slower comet trail

  // Scan / bounce
  if (n === 'scan' || n === 'scanner' || n === 'lighthouse') return 'scan';
  if (n === 'android' || n === 'oscillate') return 'scan';
  if (n === 'scan dual' || n === 'scanner dual' || n === 'icu' || n === 'two dots') return 'scan_dual';

  // Sweep (one-way fill)
  if (n === 'sweep') return 'sweep';

  // Wipe variants
  if (n === 'wipe' || n === 'wipe random' || n === 'tri wipe') return 'wipe';
  if (n === 'loading' || n === 'saw' || n === 'railway' || n === 'chunchun') return 'wipe';
  if (n === 'tetrix' || n === 'stack' || n === 'stack 3 colors') return 'wipe';

  // Stream / flow
  if (n === 'stream' || n === 'flow' || n === 'flow stripe') return 'stream';
  if (n === 'stream 2') return 'running';

  // Running
  if (n === 'running' || n === 'running dual') return 'running';

  // Juggle / balls
  if (n === 'juggle' || n === 'juggles' || n === 'rolling balls' || n === 'bouncing balls') return 'juggle';

  // Ripple / sinelon
  if (n === 'ripple' || n === 'ripple peak' || n === 'sinelon' || n === 'sinelon dual') return 'ripple';
  if (n === 'pixelwave' || n === 'sine' || n === 'wavesins') return 'ripple';

  // Colorloop
  if (n === 'colorloop' || n === 'dynamic' || n === 'dynamic smooth') return 'colorloop';
  if (n === 'random colors' || n === 'colorful' || n === 'washing machine') return 'colorloop';

  // Gradient
  if (n === 'gradient' || n === 'blends' || n === 'palette' || n === 'colorwaves') return 'gradient';
  if (n === 'aurora') return 'gradient';
  if (n === 'tri fade') return 'tri';

  // Plasma
  if (n === 'plasma' || n === 'plasmoid') return 'plasma';

  // Wave / noise / phased
  if (n === 'pacifica' || n === 'lake' || n === 'tide' || n === 'bpm') return 'wave';
  if (n === 'phased' || n === 'phased noise' || n === 'noise pal') return 'wave';
  if (n.startsWith('noise') || n === 'fill noise' || n === 'midnoise' || n === 'noisemove') return 'wave';
  if (n.startsWith('freq') || n === 'waterfall') return 'wave';
  if (n.startsWith('grav') || n === 'noisemeter') return 'wave';
  if (n === 'rocktaves' || n === 'perlin move' || n === 'gravimeter') return 'wave';
  if (n === 'pixels' || n === 'matripix' || n === 'puddles' || n === 'puddlepeak') return 'wave';
  if (n === 'freqmap' || n === 'freqpixels' || n === 'dancing shadows') return 'wave';

  // Spots
  if (n === 'spots' || n === 'spots fade') return 'solid_pattern';

  // Special
  if (n === 'halloween eyes') return 'eyes';
  if (n === 'bpm') return 'colorloop';

  return 'wave';
}

// ─── Animation functions ──────────────────────────────────────────────────────
type AnimFn = (leds: LED[], t: number, h: number) => void;

const animFns: Record<string, AnimFn> = {

  // All LEDs, same color, steady
  solid(leds, t, h) {
    const [r, g, b] = hsl(h, 100, 52);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = 0.92; });
  },

  // Smooth whole-strip pulse
  breathe(leds, t, h) {
    const v = (Math.sin(t * 1.15) + 1) / 2;
    const [r, g, b] = hsl(h, 100, 50);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = 0.05 + v * 0.88; });
  },

  // Double-beat pulse (lub-dub)
  heartbeat(leds, t, h) {
    const tp = t % 1.2;
    let v = 0;
    if      (tp < 0.09) v = tp / 0.09;
    else if (tp < 0.18) v = 1 - (tp - 0.09) / 0.09;
    else if (tp < 0.27) v = (tp - 0.18) / 0.09 * 0.65;
    else if (tp < 0.36) v = 0.65 * (1 - (tp - 0.27) / 0.09);
    const [r, g, b] = hsl(h, 100, 50);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = 0.04 + v * 0.9; });
  },

  // Sharp on/off
  blink(leds, t, h) {
    const on = Math.sin(t * Math.PI * 2.2) > 0;
    const [r, g, b] = hsl(h, 100, 55);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = on ? 0.94 : 0.03; });
  },

  // Traffic light: green → yellow → red cycling
  traffic(leds, t, h) {
    const phase = Math.floor(t * 0.9) % 3;
    const tHues = [120, 55, 0];
    const [r, g, b] = hsl(tHues[phase], 100, 48);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = 0.9; });
  },

  // Rapid white strobing
  strobe(leds, t, h) {
    const on = Math.sin(t * 22) > 0.35;
    leds.forEach(l => { l.r = 255; l.g = 255; l.b = 255; l.a = on ? 1 : 0; });
  },

  // Fire — warm directional flame
  fire(leds, t, h) {
    leds.forEach((l, i) => {
      const f1 = (Math.sin(t * (2.9 + i * 0.55) + i * 2.1) + 1) / 2;
      const f2 = (Math.sin(t * (1.6 + i * 0.3)  + i * 3.7) + 1) / 2;
      const f  = f1 * 0.65 + f2 * 0.35;
      const [r, g, b] = hsl(f * 40, 100, 28 + f * 34);
      l.r = r; l.g = g; l.b = b; l.a = 0.38 + f * 0.62;
    });
  },

  // Candle — warm organic flicker
  candle(leds, t, h) {
    leds.forEach((l, i) => {
      const f = (Math.sin(t * 2.2 + i * 1.1) + 1) / 2 * 0.55 +
                (Math.sin(t * 5.7 + i * 2.3) + 1) / 2 * 0.45;
      const [r, g, b] = hsl(22 + f * 18, 100, 40 + f * 22);
      l.r = r; l.g = g; l.b = b; l.a = 0.5 + f * 0.45;
    });
  },

  // Dark bg, sudden random bright flashes
  sparkle(leds, t, h) {
    const [r, g, b] = hsl(h, 100, 60);
    leds.forEach((l, i) => {
      const on = Math.sin(t * 11.7 + i * 5.3) > 0.72;
      l.r = r; l.g = g; l.b = b; l.a = on ? 0.95 : 0.04;
    });
  },

  // Each LED twinkles independently
  twinkle(leds, t, h) {
    const [r, g, b] = hsl(h, 100, 54);
    leds.forEach((l, i) => {
      l.r = r; l.g = g; l.b = b;
      l.a = Math.max(0.03, (Math.sin(t * (1.4 + i * 0.63) + i * 2.4) + 1) / 2 * 0.9);
    });
  },

  // Each LED fades in/out at its own random phase
  dissolve(leds, t, h) {
    const [r, g, b] = hsl(h, 100, 55);
    leds.forEach((l, i) => {
      const phase = (t * 0.8 + i * 0.43) % 1;
      const v = phase < 0.5 ? phase * 2 : (1 - (phase - 0.5) * 2);
      l.r = r; l.g = g; l.b = b; l.a = 0.04 + v * 0.88;
    });
  },

  // Single dot with 5-LED trailing fade
  chase(leds, t, h) {
    const pos = (t * 1.6 % 1) * (N + 5) - 2.5;
    const [r, g, b] = hsl(h, 100, 55);
    leds.forEach((l, i) => {
      const trail = pos - i;
      l.r = r; l.g = g; l.b = b;
      l.a = (trail >= 0 && trail < 5) ? (1 - trail / 5) * 0.94 : 0.03;
    });
  },

  // Chase with rapid flash at the leading edge
  chase_flash(leds, t, h) {
    const pos   = (t * 1.6 % 1) * (N + 5) - 2.5;
    const flash = Math.sin(t * 22) > 0.4;
    const [r, g, b] = hsl(h, 100, 55);
    leds.forEach((l, i) => {
      const trail = pos - i;
      l.r = r; l.g = g; l.b = b;
      if (trail > -0.5 && trail < 0.5) {
        l.a = flash ? 0.98 : 0.25;
      } else if (trail >= 0.5 && trail < 8) {
        l.a = (1 - trail / 8) * 0.8;
      } else {
        l.a = 0.03;
      }
    });
  },

  // Every 3rd LED lit, pattern shifts — theater marquee
  theater(leds, t, h) {
    const offset = Math.floor(t * 9) % 3;
    const [r, g, b] = hsl(h, 100, 55);
    leds.forEach((l, i) => {
      const lit = ((i + offset) % 3) === 0;
      l.r = r; l.g = g; l.b = b; l.a = lit ? 0.92 : 0.05;
    });
  },

  // Single dot bouncing left↔right (ping-pong)
  scan(leds, t, h) {
    const pos = ((Math.sin(t * 2.2) + 1) / 2) * (N - 1);
    const [r, g, b] = hsl(h, 100, 60);
    leds.forEach((l, i) => {
      const d = Math.abs(i - pos);
      l.r = r; l.g = g; l.b = b;
      l.a = Math.max(0.03, (1 - d * 0.52) * 0.94);
    });
  },

  // Two dots bouncing inward/outward from ends
  scan_dual(leds, t, h) {
    const pos1 = ((Math.sin(t * 2.2) + 1) / 2) * (N - 1);
    const pos2 = (N - 1) - pos1;
    const [r, g, b] = hsl(h, 100, 60);
    leds.forEach((l, i) => {
      const d = Math.min(Math.abs(i - pos1), Math.abs(i - pos2));
      l.r = r; l.g = g; l.b = b;
      l.a = Math.max(0.03, (1 - d * 0.52) * 0.92);
    });
  },

  // One-way fill from left, resets
  sweep(leds, t, h) {
    const pos = ((t * 0.55) % 1) * (N + 2) - 1;
    const [r, g, b] = hsl(h, 100, 50);
    leds.forEach((l, i) => {
      l.r = r; l.g = g; l.b = b;
      const edge = Math.min(1, pos - i + 1);
      l.a = i <= pos ? Math.max(0.04, edge) * 0.9 : 0.04;
    });
  },

  // Two-color wipe: primary color sweeps over secondary
  wipe(leds, t, h) {
    const pos = ((t * 0.55) % 1) * (N + 2) - 1;
    const [r1, g1, b1] = hsl(h, 100, 50);
    const [r2, g2, b2] = hsl((h + 180) % 360, 80, 28);
    leds.forEach((l, i) => {
      if (i < pos) { l.r = r1; l.g = g1; l.b = b1; l.a = 0.88; }
      else         { l.r = r2; l.g = g2; l.b = b2; l.a = 0.28; }
    });
  },

  // Three coloured dots flowing at different speeds
  stream(leds, t, h) {
    leds.forEach(l => { l.r = 0; l.g = 0; l.b = 0; l.a = 0.03; });
    [[1.55, 0,    h], [1.0, 0.35, (h+40)%360], [0.65, 0.7, (h+80)%360]].forEach(([spd, off, hue]) => {
      const pos = ((t * (spd as number) + (off as number)) % 1) * (N + 4) - 2;
      const [r, g, b] = hsl(hue as number, 100, 55);
      leds.forEach((l, i) => {
        const trail = pos - i;
        if (trail >= 0 && trail < 5) {
          const a = (1 - trail / 5) * 0.88;
          l.r = clamp(l.r + r * a); l.g = clamp(l.g + g * a); l.b = clamp(l.b + b * a);
          l.a = Math.min(0.95, l.a + a);
        }
      });
    });
  },

  // Three identical comets at equal spacing, same speed
  running(leds, t, h) {
    leds.forEach(l => { l.r = 0; l.g = 0; l.b = 0; l.a = 0.03; });
    const [r, g, b] = hsl(h, 100, 55);
    [0, 0.333, 0.666].forEach(off => {
      const pos = ((t * 1.35 + off) % 1) * (N + 4) - 2;
      leds.forEach((l, i) => {
        const trail = pos - i;
        if (trail >= 0 && trail < 4) {
          const a = (1 - trail / 4) * 0.85;
          l.r = clamp(l.r + r * a); l.g = clamp(l.g + g * a); l.b = clamp(l.b + b * a);
          l.a = Math.min(0.95, l.a + a);
        }
      });
    });
  },

  // Full rainbow spectrum scrolling
  rainbow(leds, t, h) {
    leds.forEach((l, i) => {
      const [r, g, b] = hsl((i * (360 / N) + t * 65) % 360, 100, 52);
      l.r = r; l.g = g; l.b = b; l.a = 0.9;
    });
  },

  // Rainbow spectrum with a bright chasing dot overlay
  rainbow_chase(leds, t, h) {
    const cpos = (t * 1.6 % 1) * (N + 4) - 2;
    leds.forEach((l, i) => {
      const [r, g, b] = hsl((i * (360 / N) + t * 65) % 360, 100, 52);
      l.r = r; l.g = g; l.b = b; l.a = 0.55;
      const trail = cpos - i;
      if (trail >= 0 && trail < 4) {
        const boost = (1 - trail / 4) * 0.45;
        l.r = clamp(l.r + 255 * boost); l.g = clamp(l.g + 255 * boost); l.b = clamp(l.b + 255 * boost);
        l.a = Math.min(0.97, l.a + boost);
      }
    });
  },

  // Whole strip slowly shifts hue (solid but cycling)
  colorloop(leds, t, h) {
    const [r, g, b] = hsl((t * 38) % 360, 100, 50);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = 0.9; });
  },

  // Two-tone gradient that slowly shifts position
  gradient(leds, t, h) {
    leds.forEach((l, i) => {
      const [r, g, b] = hsl((h + i * (180 / N) + t * 22) % 360, 90, 50);
      l.r = r; l.g = g; l.b = b; l.a = 0.85;
    });
  },

  // Brightness sine wave rolling through
  wave(leds, t, h) {
    leds.forEach((l, i) => {
      const v = (Math.sin(i * 0.58 - t * 2.6) + 1) / 2;
      const [r, g, b] = hsl(h, 100, 38 + v * 16);
      l.r = r; l.g = g; l.b = b; l.a = v * 0.85 + 0.07;
    });
  },

  // Single slow comet with long 10-LED trail
  meteor(leds, t, h) {
    const pos = (t * 0.62 % 1.35) * N;
    const [r, g, b] = hsl(h, 100, 58);
    leds.forEach((l, i) => {
      const trail = pos - i;
      l.r = r; l.g = g; l.b = b;
      l.a = (trail >= 0 && trail < 10) ? (1 - trail / 10) * 0.94 : 0.02;
    });
  },

  // Multi-colored balls bouncing at different speeds
  juggle(leds, t, h) {
    leds.forEach(l => { l.r = 0; l.g = 0; l.b = 0; l.a = 0.02; });
    [[2.1, 0,    h], [1.35, 0.4, (h+110)%360], [0.85, 0.8, (h+220)%360]].forEach(([spd, off, hue]) => {
      const pos = ((Math.sin(t * (spd as number) + (off as number)) + 1) / 2) * (N - 1);
      const [r, g, b] = hsl(hue as number, 100, 55);
      leds.forEach((l, i) => {
        const d = Math.abs(i - pos);
        if (d < 4) {
          const a = (1 - d / 4) * 0.88;
          l.r = clamp(l.r + r * a); l.g = clamp(l.g + g * a); l.b = clamp(l.b + b * a);
          l.a = Math.min(0.95, l.a + a);
        }
      });
    });
  },

  // Waves emanating from center outward
  ripple(leds, t, h) {
    const center = N / 2;
    leds.forEach((l, i) => {
      const dist = Math.abs(i - center);
      const v    = (Math.sin(dist * 0.75 - t * 3.2) + 1) / 2;
      const [r, g, b] = hsl(h, 100, 42 + v * 14);
      l.r = r; l.g = g; l.b = b; l.a = v * 0.85 + 0.07;
    });
  },

  // Shifting multi-color interference pattern
  plasma(leds, t, h) {
    leds.forEach((l, i) => {
      const v = Math.sin(i * 0.32 + t * 1.6) + Math.sin(i * 0.72 - t * 0.9) + Math.sin((i + t * 2.1) * 0.5);
      const [r, g, b] = hsl((h + v * 45) % 360, 100, 50);
      l.r = r; l.g = g; l.b = b; l.a = 0.86;
    });
  },

  // Three color sections cycling
  tri(leds, t, h) {
    const shift = Math.floor(t * 1.5) % 3;
    leds.forEach((l, i) => {
      const sec = (Math.floor(i * 3 / N) + shift) % 3;
      const [r, g, b] = hsl((h + sec * 120) % 360, 100, 50);
      l.r = r; l.g = g; l.b = b; l.a = 0.88;
    });
  },

  // Alternating color blocks
  solid_pattern(leds, t, h) {
    leds.forEach((l, i) => {
      const alt = Math.floor(i / 3) % 2 === 0;
      const [r, g, b] = hsl(alt ? h : (h + 180) % 360, 88, alt ? 50 : 32);
      l.r = r; l.g = g; l.b = b; l.a = alt ? 0.9 : 0.38;
    });
  },

  // Two bright eyes in center area, occasional blink
  eyes(leds, t, h) {
    const eyeL = Math.floor(N * 0.33);
    const eyeR = Math.floor(N * 0.67);
    const open = Math.sin(t * 0.35) > 0.88 ? 0 : 1;
    const [r, g, b] = hsl(h || 0, 100, 55);
    leds.forEach((l, i) => {
      const d = Math.min(Math.abs(i - eyeL), Math.abs(i - eyeR));
      l.r = r; l.g = g; l.b = b;
      l.a = d < 2 ? open * (1 - d * 0.28) * 0.92 : 0.02;
    });
  },
};

// ─── Draw house + LEDs onto canvas ────────────────────────────────────────────
function drawScene(canvas: HTMLCanvasElement, state: State) {
  const ctx = canvas.getContext('2d');
  if (!ctx) return;
  const dpr = state.dpr;

  ctx.clearRect(0, 0, canvas.width, canvas.height);
  ctx.save();
  ctx.scale(dpr, dpr);

  // --- House silhouette ---
  const eY  = EAVE_Y, pX = PEAK_X, pY = PEAK_Y;
  const eLX = EAVE_LX, eRX = EAVE_RX;
  const wLX = WALL_LX, wRX = WALL_RX;

  // Wall body
  ctx.fillStyle   = '#0f0f12';
  ctx.strokeStyle = '#1e1e26';
  ctx.lineWidth   = 0.7;
  ctx.beginPath();
  ctx.rect(wLX, eY, wRX - wLX, CH - eY);
  ctx.fill();
  ctx.stroke();

  // Roof (triangle)
  ctx.fillStyle   = '#0c0c0f';
  ctx.strokeStyle = '#1a1a22';
  ctx.beginPath();
  ctx.moveTo(eLX - 2, eY);
  ctx.lineTo(pX, pY);
  ctx.lineTo(eRX + 2, eY);
  ctx.closePath();
  ctx.fill();
  ctx.stroke();

  // Left window
  const winW = CW * 0.10, winH = CH * 0.14, winY = eY + CH * 0.11;
  ctx.fillStyle = '#090912'; ctx.strokeStyle = '#181820';
  ctx.beginPath(); ctx.rect(wLX + CW * 0.07, winY, winW, winH); ctx.fill(); ctx.stroke();
  // Right window
  ctx.beginPath(); ctx.rect(wRX - CW * 0.07 - winW, winY, winW, winH); ctx.fill(); ctx.stroke();
  // Door
  const dW = CW * 0.12, dH = CH * 0.24;
  ctx.beginPath(); ctx.rect(pX - dW / 2, CH - dH, dW, dH); ctx.fill(); ctx.stroke();

  // --- LED strip along eave ---
  const R = 2.5;  // dot radius
  state.leds.forEach((l, i) => {
    const x = eLX + i * LED_STEP;
    const y = eY;
    const a = Math.min(1, l.a);
    if (a < 0.015) return;

    // Glow halo
    const grd = ctx.createRadialGradient(x, y, 0, x, y, R * 4);
    grd.addColorStop(0,   `rgba(${l.r},${l.g},${l.b},${(a * 0.55).toFixed(2)})`);
    grd.addColorStop(1,   `rgba(${l.r},${l.g},${l.b},0)`);
    ctx.beginPath();
    ctx.arc(x, y, R * 4, 0, Math.PI * 2);
    ctx.fillStyle = grd;
    ctx.fill();

    // Dot
    ctx.beginPath();
    ctx.arc(x, y, R, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(${l.r},${l.g},${l.b},${a.toFixed(2)})`;
    ctx.fill();
  });

  ctx.restore();
}

// ─── Build one card ───────────────────────────────────────────────────────────
function buildCard(fx: { id: number; name: string }) {
  const hue      = (fx.id * 37 + 15) % 360;
  const animType = getAnimType(fx.name);
  const dpr      = Math.min(window.devicePixelRatio || 1, 2);

  const card = document.createElement('div');
  card.className    = 'fx-card';
  card.dataset.name = fx.name.toLowerCase();

  const canvas = document.createElement('canvas');
  canvas.className  = 'led-canvas';
  canvas.width      = CW * dpr;
  canvas.height     = CH * dpr;

  const leds: LED[] = Array.from({ length: N }, () => ({ r: 0, g: 0, b: 0, a: 0 }));
  states.set(canvas, { type: animType, hue, leds, dpr });
  observer.observe(canvas);

  const body = document.createElement('div');
  body.className = 'fx-body';
  body.innerHTML = `<span class="fx-name">${fx.name}</span><span class="fx-num">FX ${fx.id}</span>`;

  card.appendChild(canvas);
  card.appendChild(body);
  return card;
}

// ─── IntersectionObserver ─────────────────────────────────────────────────────
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    const c = e.target as HTMLCanvasElement;
    if (e.isIntersecting) visible.add(c);
    else visible.delete(c);
  });
}, { rootMargin: '160px' });

// ─── Render grid ──────────────────────────────────────────────────────────────
const grid = document.getElementById('effectsGrid')!;
const frag = document.createDocumentFragment();
EFFECTS.forEach(fx => frag.appendChild(buildCard(fx)));
grid.appendChild(frag);

// ─── RAF loop ─────────────────────────────────────────────────────────────────
const T0 = performance.now();
function loop() {
  const t = (performance.now() - T0) / 1000;
  visible.forEach(canvas => {
    const state = states.get(canvas);
    if (!state) return;
    (animFns[state.type] ?? animFns.wave)(state.leds, t, state.hue);
    drawScene(canvas, state);
  });
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

// ─── Search filter ────────────────────────────────────────────────────────────
const searchEl = document.getElementById('fxSearch') as HTMLInputElement | null;
const countEl  = document.getElementById('searchCount');
const noRes    = document.getElementById('noResults');

function refresh() {
  const q = searchEl?.value.toLowerCase().trim() ?? '';
  let shown = 0;
  grid.querySelectorAll<HTMLElement>('.fx-card').forEach(card => {
    const match = !q || (card.dataset.name ?? '').includes(q);
    card.style.display = match ? '' : 'none';
    if (match) shown++;
  });
  if (countEl) {
    if (q) {
      countEl.textContent = `${shown} result${shown !== 1 ? 's' : ''}`;
      countEl.style.display = '';
    } else {
      countEl.style.display = 'none';
    }
  }
  if (noRes) noRes.style.display = shown === 0 ? 'block' : 'none';
}

searchEl?.addEventListener('input', refresh);
</script>

