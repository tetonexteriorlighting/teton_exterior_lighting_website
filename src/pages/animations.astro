// ─── Canvas constants ────────────────────────────────────────
const N   = 24;   // LED count
const DOT = 7;    // dot diameter px
const GAP = 2;    // gap between dots px
const CW  = N * (DOT + GAP); // 216
const CH  = 22;

// ─── HSL → RGB ───────────────────────────────────────────────
function hsl(h: number, s: number, l: number): [number, number, number] {
  h = ((h % 360) + 360) % 360;
  s /= 100; l /= 100;
  const c = (1 - Math.abs(2 * l - 1)) * s;
  const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
  const m = l - c / 2;
  let r = 0, g = 0, b = 0;
  if (h < 60)        { r = c; g = x; b = 0; }
  else if (h < 120)  { r = x; g = c; b = 0; }
  else if (h < 180)  { r = 0; g = c; b = x; }
  else if (h < 240)  { r = 0; g = x; b = c; }
  else if (h < 300)  { r = x; g = 0; b = c; }
  else               { r = c; g = 0; b = x; }
  return [(r + m) * 255, (g + m) * 255, (b + m) * 255];
}

// ─── Animation type lookup ───────────────────────────────────
function getAnimType(name: string): string {
  const n = name.toLowerCase();
  if (n.includes('rainbow') || n === 'pride 2015' || n === 'sinelon rainbow') return 'rainbow';
  if (n.includes('fire') || n.includes('candle') || n === 'noisefire') return 'fire';
  if (n === 'strobe' || n === 'strobe mega' || n === 'lightning' || n === 'dj light' || n === 'tv simulator') return 'strobe';
  if (n.includes('meteor') || n.includes('comet') || n === 'chase tail' || n === 'glints') return 'meteor';
  if (n === 'blink' || n === 'blink rainbow' || n === 'traffic light' || n === 'pulse train' || n === 'bpm') return 'blink';
  if (n === 'breathe' || n === 'fade' || n === 'tri fade' || n === 'heartbeat' || n === 'sunrise' || n === 'percent') return 'breathe';
  if (n.includes('scan') || n === 'android' || n === 'lighthouse' || n === 'icu' || n === 'oscillate' || n === 'two dots' || n === 'halloween eyes') return 'scan';
  if (n.includes('chase') || n.includes('running') || n.includes('stream') || n === 'juggle' || n === 'juggles' || n === 'drip' || n === 'flow' || n === 'chunchun' || n === 'flow stripe' || n === 'stack' || n === 'theater' || n === 'sweep' || n === 'sweep random') return 'chase';
  if (n.includes('wipe') || n === 'loading' || n === 'saw' || n === 'railway' || n === 'stack 3 colors' || n.includes('grav') || n === 'noisemeter' || n === 'tetrix') return 'wipe';
  if (n === 'gradient' || n === 'blends' || n === 'palette' || n === 'colorwaves' || n === 'aurora') return 'gradient';
  if (n === 'colorloop' || n === 'colorful' || n === 'washing machine' || n === 'random colors' || n === 'solid glitter' || n === 'colortwinkles' || n === 'dynamic' || n === 'dynamic smooth') return 'colorloop';
  if (n.includes('twinkle') || n.includes('fairy') || n.includes('noise') || n === 'fill noise' || n === 'sparkle' || n === 'sparkle dark' || n === 'sparkle+' || n === 'glitter' || n === 'popcorn' || n === 'dissolve' || n === 'dissolve rnd' || n === 'pixels' || n === 'matripix' || n === 'midnoise') return 'twinkle';
  if (n === 'sparkle' || n === 'fireworks' || n === 'fireworks starburst' || n === 'fireworks 1d' || n === 'rain' || n === 'spots' || n === 'spots fade' || n === 'bouncing balls' || n === 'rolling balls' || n === 'puddles' || n === 'popcorn' || n === 'freqpixels') return 'sparkle';
  if (n.includes('solid') || n === 'fill noise') return 'solid';
  if (n.includes('wave') || n.includes('ripple') || n === 'pacifica' || n.includes('plasma') || n === 'lake' || n === 'tide' || n.includes('sine') || n.includes('phased') || n === 'perlin move' || n === 'pixelwave' || n === 'wavesins' || n === 'waterfall' || n === 'freqwave' || n === 'rocktaves' || n === 'bpm') return 'wave';
  return 'wave';
}

// ─── LED state type ──────────────────────────────────────────
type LED = { r: number; g: number; b: number; a: number };

// ─── Animation functions ─────────────────────────────────────
const animFns: Record<string, (leds: LED[], t: number, h: number) => void> = {

  solid(leds, t, h) {
    const [r, g, b] = hsl(h, 100, 50);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = 0.85; });
  },

  breathe(leds, t, h) {
    const a = ((Math.sin(t * 1.3) + 1) / 2) * 0.85 + 0.05;
    const [r, g, b] = hsl(h, 100, 50);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = a; });
  },

  blink(leds, t, h) {
    const on = Math.sin(t * 4) > 0;
    const [r, g, b] = hsl(h, 100, 50);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = on ? 0.9 : 0.04; });
  },

  chase(leds, t, h) {
    const pos = (t * 1.2 % 1) * (leds.length + 3) - 1.5;
    const [r, g, b] = hsl(h, 100, 55);
    leds.forEach((l, i) => {
      const d = Math.abs(i - pos);
      l.r = r; l.g = g; l.b = b;
      l.a = Math.max(0.03, (1 - d * 0.38)) * 0.92;
    });
  },

  scan(leds, t, h) {
    const pos = ((Math.sin(t * 1.8) + 1) / 2) * (leds.length - 1);
    const [r, g, b] = hsl(h, 100, 60);
    leds.forEach((l, i) => {
      const d = Math.abs(i - pos);
      l.r = r; l.g = g; l.b = b;
      l.a = Math.max(0.03, 1 - d * 0.55) * 0.95;
    });
  },

  rainbow(leds, t, h) {
    leds.forEach((l, i) => {
      const [r, g, b] = hsl((h + i * (360 / leds.length) + t * 80) % 360, 100, 50);
      l.r = r; l.g = g; l.b = b; l.a = 0.85;
    });
  },

  twinkle(leds, t, h) {
    const [r, g, b] = hsl(h, 100, 52);
    leds.forEach((l, i) => {
      l.r = r; l.g = g; l.b = b;
      l.a = Math.max(0.04, (Math.sin(t * (1.5 + i * 0.79) + i * 1.7) + 1) / 2 * 0.88);
    });
  },

  fire(leds, t, h) {
    leds.forEach((l, i) => {
      const flicker = (Math.sin(t * (2.5 + i * 0.61) + i * 2.3) + 1) / 2;
      const [r, g, b] = hsl(8 + flicker * 32, 100, 28 + flicker * 32);
      l.r = r; l.g = g; l.b = b; l.a = 0.5 + flicker * 0.5;
    });
  },

  strobe(leds, t, h) {
    const on = Math.sin(t * 14) > 0.55;
    const [r, g, b] = hsl(h, 20, 56);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = on ? 1 : 0; });
  },

  meteor(leds, t, h) {
    const pos = (t * 0.7 % 1.4) * leds.length - 1;
    const [r, g, b] = hsl(h, 100, 55);
    leds.forEach((l, i) => {
      const trail = pos - i;
      l.r = r; l.g = g; l.b = b;
      l.a = (trail >= 0 && trail < 7) ? Math.max(0.03, (1 - trail / 7) * 0.92) : 0.03;
    });
  },

  wave(leds, t, h) {
    leds.forEach((l, i) => {
      const bright = (Math.sin(i * 0.55 - t * 2.2) + 1) / 2;
      const [r, g, b] = hsl(h, 100, 35 + bright * 22);
      l.r = r; l.g = g; l.b = b; l.a = bright * 0.85 + 0.08;
    });
  },

  colorloop(leds, t, h) {
    const [r, g, b] = hsl((h + t * 45) % 360, 100, 50);
    leds.forEach(l => { l.r = r; l.g = g; l.b = b; l.a = 0.85; });
  },

  wipe(leds, t, h) {
    const pos = (t * 0.45 % 1) * leds.length;
    leds.forEach((l, i) => {
      const inWipe = i < pos;
      const [r, g, b] = inWipe ? hsl(h, 100, 50) : hsl((h + 180) % 360, 80, 28);
      l.r = r; l.g = g; l.b = b; l.a = inWipe ? 0.88 : 0.22;
    });
  },

  sparkle(leds, t, h) {
    const [r, g, b] = hsl(h, 100, 50);
    leds.forEach((l, i) => {
      const spark = Math.sin(t * 8.3 + i * 4.13) > 0.8;
      l.r = r; l.g = g; l.b = b; l.a = spark ? 0.95 : 0.05;
    });
  },

  gradient(leds, t, h) {
    leds.forEach((l, i) => {
      const [r, g, b] = hsl((h + i * (220 / leds.length) + t * 28) % 360, 90, 50);
      l.r = r; l.g = g; l.b = b; l.a = 0.8;
    });
  },
};

// ─── Draw LEDs on canvas ─────────────────────────────────────
function drawLeds(ctx: CanvasRenderingContext2D, leds: LED[]) {
  ctx.clearRect(0, 0, CW, CH);
  leds.forEach((l, i) => {
    const x = i * (DOT + GAP) + DOT / 2;
    const y = CH / 2;
    const a = Math.min(1, l.a);
    if (a < 0.02) return;

    // Glow halo
    const grd = ctx.createRadialGradient(x, y, 0, x, y, DOT * 1.6);
    grd.addColorStop(0, `rgba(${l.r | 0},${l.g | 0},${l.b | 0},${(a * 0.55).toFixed(2)})`);
    grd.addColorStop(1, `rgba(${l.r | 0},${l.g | 0},${l.b | 0},0)`);
    ctx.beginPath();
    ctx.arc(x, y, DOT * 1.55, 0, Math.PI * 2);
    ctx.fillStyle = grd;
    ctx.fill();

    // Core dot
    ctx.beginPath();
    ctx.arc(x, y, DOT / 2, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(${l.r | 0},${l.g | 0},${l.b | 0},${a.toFixed(2)})`;
    ctx.fill();
  });
}

// ─── Canvas state registry ───────────────────────────────────
interface CanvasState { type: string; hue: number; leds: LED[] }
const states = new Map<HTMLCanvasElement, CanvasState>();
const visible = new Set<HTMLCanvasElement>();

const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    const c = e.target as HTMLCanvasElement;
    if (e.isIntersecting) visible.add(c);
    else visible.delete(c);
  });
}, { rootMargin: '120px' });

// ─── Category colors ─────────────────────────────────────────
const CAT_COLOR: Record<string, string> = {
  MOTION:   '#4A90D9',
  COLOR:    '#F0C000',
  SEASONAL: '#4CAF50',
  ADVANCED: '#9B59B6',
};

// ─── Build a card ────────────────────────────────────────────
function buildCard(fx: typeof EFFECTS[number]) {
  const hue      = (fx.id * 37 + 15) % 360;
  const animType = getAnimType(fx.name);
  const cc       = CAT_COLOR[fx.cat] ?? '#888';

  const card = document.createElement('div');
  card.className = 'fx-card';
  card.dataset.cat  = fx.cat;
  card.dataset.name = fx.name.toLowerCase();

  const canvas = document.createElement('canvas');
  canvas.width  = CW;
  canvas.height = CH;
  canvas.className = 'led-canvas';

  const leds: LED[] = Array.from({ length: N }, () => ({ r: 255, g: 200, b: 0, a: 0.5 }));
  states.set(canvas, { type: animType, hue, leds });
  observer.observe(canvas);

  const previewWrap = document.createElement('div');
  previewWrap.className = 'led-wrap';
  previewWrap.appendChild(canvas);

  const body = document.createElement('div');
  body.className = 'fx-body';
  body.innerHTML = `
    <div class="fx-top">
      <span class="fx-name">${fx.name}</span>
      <span class="fx-badge" style="background:${cc}18;color:${cc};border-color:${cc}40">${fx.cat}</span>
    </div>
    <div class="fx-sub">FX ${fx.id}${fx.params ? ` · ${fx.params}` : ''}</div>
  `;

  card.appendChild(previewWrap);
  card.appendChild(body);
  return card;
}

// ─── Render all cards ────────────────────────────────────────
const grid = document.getElementById('effectsGrid')!;
const frag = document.createDocumentFragment();
EFFECTS.forEach(fx => frag.appendChild(buildCard(fx)));
grid.appendChild(frag);

// ─── Animation loop ──────────────────────────────────────────
const T0 = performance.now();
function loop() {
  const t = (performance.now() - T0) / 1000;
  visible.forEach(canvas => {
    const state = states.get(canvas);
    if (!state) return;
    const fn = animFns[state.type] ?? animFns.wave;
    fn(state.leds, t, state.hue);
    const ctx = canvas.getContext('2d');
    if (ctx) drawLeds(ctx, state.leds);
  });
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

// ─── Filters & search ────────────────────────────────────────
let activeFilter = 'all';
let activeSearch = '';

function refresh() {
  let count = 0;
  grid.querySelectorAll<HTMLElement>('.fx-card').forEach(card => {
    const matchCat    = activeFilter === 'all' || card.dataset.cat === activeFilter;
    const matchSearch = !activeSearch || (card.dataset.name ?? '').includes(activeSearch);
    const show = matchCat && matchSearch;
    card.style.display = show ? '' : 'none';
    if (show) count++;
  });
  const vc = document.getElementById('visibleCount');
  if (vc) vc.textContent = String(count);
  const nr = document.getElementById('noResults');
  if (nr) nr.style.display = count === 0 ? 'block' : 'none';
}

document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeFilter = btn.dataset.filter ?? 'all';
    refresh();
  });
});

const searchEl = document.getElementById('fxSearch') as HTMLInputElement | null;
searchEl?.addEventListener('input', () => {
  activeSearch = searchEl.value.toLowerCase().trim();
  refresh();
});
</script>

