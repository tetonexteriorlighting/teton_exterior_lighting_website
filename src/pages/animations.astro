---
import Layout from '../layouts/Layout.astro';
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Lighting Animations & Effects | Teton Exterior Lighting | Idaho Falls"
  description="Browse all 153 ShowHome app animations available with your permanent LED lighting system — from subtle warm glows to full holiday displays. All app-controlled from your phone."
>
  <Nav />

  <!-- ===================================================
       HERO
  =================================================== -->
  <section class="anim-hero">
    <div class="container">
      <span class="eyebrow center">App-Controlled Effects</span>
      <div class="gold-rule center"></div>
      <h1 class="section-title" style="text-align:center">Lighting Animation Library</h1>
      <p class="section-body" style="text-align:center;max-width:660px;margin:0.75rem auto 0">
        Every effect built into the ShowHome controller — right on your phone. Browse all 153 lighting
        animations, from quiet warm glows to full holiday displays. Your home, your mood, your moment.
      </p>
      <div class="hero-chips">
        <span class="chip chip-motion">40 Motion</span>
        <span class="chip chip-color">22 Color</span>
        <span class="chip chip-seasonal">22 Seasonal</span>
        <span class="chip chip-advanced">69 Advanced</span>
      </div>
    </div>
  </section>

  <!-- ===================================================
       CONTROLS
  =================================================== -->
  <section class="controls-section">
    <div class="container">
      <div class="controls-row">
        <div class="filter-tabs" id="filterTabs">
          <button class="filter-btn active" data-filter="all">All <span class="fbadge">153</span></button>
          <button class="filter-btn" data-filter="MOTION">Motion <span class="fbadge">40</span></button>
          <button class="filter-btn" data-filter="COLOR">Color <span class="fbadge">22</span></button>
          <button class="filter-btn" data-filter="SEASONAL">Seasonal <span class="fbadge">22</span></button>
          <button class="filter-btn" data-filter="ADVANCED">Advanced <span class="fbadge">69</span></button>
        </div>
        <input type="search" id="fxSearch" class="fx-search" placeholder="Search effects…" autocomplete="off" />
      </div>
      <p class="results-line"><span id="visibleCount">153</span> effects shown</p>
    </div>
  </section>

  <!-- ===================================================
       GRID
  =================================================== -->
  <section class="grid-section">
    <div class="container">
      <div id="effectsGrid" class="effects-grid"></div>
      <p id="noResults" class="no-results" style="display:none">No effects match your search.</p>
    </div>
  </section>

  <!-- ===================================================
       CTA
  =================================================== -->
  <section class="anim-cta">
    <div class="container anim-cta-inner">
      <div>
        <h2>All 153 Effects. One App.</h2>
        <p>Change your home's look in seconds from anywhere in the world. Get your permanent LED system installed today.</p>
      </div>
      <a href="/contact" class="btn btn-gold btn-lg">Get My Free Quote →</a>
    </div>
  </section>

  <Footer />
</Layout>

