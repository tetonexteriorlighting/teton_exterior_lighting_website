---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Installer Tools · Teton Exterior Lighting"
  description="Teton Exterior Lighting installer tools."
  noindex={true}
>
  <div style="min-height:100vh;background:#090910;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:system-ui,sans-serif;color:#e2e8f0;padding:2rem;">

    <div style="text-align:center;margin-bottom:3rem;">
      <a href="/" style="display:inline-block;margin-bottom:1.5rem;">
        <img src="/images/logo.png" alt="Teton Exterior Lighting" style="height:52px;opacity:0.9;" />
      </a>
      <h1 style="font-size:1.5rem;font-weight:700;color:#f8fafc;margin:0 0 0.5rem;">Installer Portal</h1>
      <p style="color:#475569;font-size:0.9rem;margin:0;">Tools for Teton Exterior Lighting installers</p>
    </div>

    <!-- Tool card -->
    <div style="display:grid;gap:1rem;width:100%;max-width:480px;">
      <a href="/tools/app/" style="text-decoration:none;">
        <div
          style="
            background:rgba(255,255,255,0.04);
            border:1px solid rgba(255,255,255,0.08);
            border-radius:16px;
            padding:1.5rem 2rem;
            display:flex;align-items:center;gap:1.25rem;
            transition:all 0.18s ease;
            cursor:pointer;
          "
          onmouseover="this.style.background='rgba(251,191,36,0.07)';this.style.borderColor='rgba(251,191,36,0.25)'"
          onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.borderColor='rgba(255,255,255,0.08)'"
        >
          <div style="font-size:2.2rem;line-height:1;">💡</div>
          <div style="flex:1;">
            <div style="font-size:1rem;font-weight:600;color:#f8fafc;margin-bottom:0.25rem;">
              RoofLit — Design Tool
            </div>
            <div style="font-size:0.8rem;color:#64748b;line-height:1.5;">
              Upload a photo, trace rooflines, preview light colors &amp; animations, measure and export.
            </div>
          </div>
          <div style="color:#475569;font-size:1.2rem;">→</div>
        </div>
      </a>
    </div>

    <p style="margin-top:3rem;color:#1e293b;font-size:0.75rem;">
      This page is not publicly listed. Keep the URL private.
    </p>
  </div>
</Layout>
