---
// Staff AI training portal — password protected, not in public nav
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Staff Portal · Teton Exterior Lighting</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
</head>
<body>

<!-- ── Top bar ────────────────────────────────────────────────────── -->
<header class="topbar">
  <div class="topbar-inner">
    <div class="topbar-brand">
      <img src="/images/logo.png" alt="Teton Exterior Lighting" class="topbar-logo" />
      <div class="topbar-title">
        <span class="topbar-company">Teton Exterior Lighting</span>
        <span class="topbar-portal">Staff Training Portal</span>
      </div>
    </div>
    <div class="topbar-right">
      <span class="online-pill">
        <span class="online-dot"></span>AI Online
      </span>
      <button id="logoutBtn" class="logout-btn">Log Out</button>
    </div>
  </div>
</header>

<!-- ── Layout ─────────────────────────────────────────────────────── -->
<div class="layout">

  <!-- Sidebar -->
  <aside class="sidebar">
    <p class="sidebar-label">Quick Topics</p>
    <div class="topic-list" id="topicList">
      <button class="topic-btn" data-q="Walk me through the full installation process step by step.">Installation steps</button>
      <button class="topic-btn" data-q="What are the key specs and selling points of the ShowHome system?">ShowHome specs</button>
      <button class="topic-btn" data-q="A customer says it's too expensive. What should I say?">Handle price objection</button>
      <button class="topic-btn" data-q="Customer asks how it looks during the day. How do I answer?">Daytime appearance</button>
      <button class="topic-btn" data-q="How do I respond if a customer asks about snow and winter weather?">Winter weather</button>
      <button class="topic-btn" data-q="The app isn't connecting to the lights. What do I check first?">App troubleshooting</button>
      <button class="topic-btn" data-q="A section of LEDs stopped working. What could it be?">Section not working</button>
      <button class="topic-btn" data-q="What's our warranty policy and how do we handle warranty claims?">Warranty policy</button>
      <button class="topic-btn" data-q="What should I do after every installation before leaving the job site?">Post-install checklist</button>
      <button class="topic-btn" data-q="How should I explain pricing to a customer without giving a hard number?">Explaining pricing</button>
      <button class="topic-btn" data-q="A customer is comparing us to buying lights on Amazon. What do I say?">vs. Amazon DIY</button>
      <button class="topic-btn" data-q="What cities and areas do we serve?">Service area</button>
    </div>

    <div class="sidebar-footer">
      <button class="clear-btn" id="clearBtn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
        New conversation
      </button>
    </div>
  </aside>

  <!-- Chat area -->
  <main class="chat-main">
    <div class="messages" id="messages">
      <!-- Welcome message -->
      <div class="msg msg-ai">
        <div class="msg-avatar ai-avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
        </div>
        <div class="msg-bubble">
          <p>Hey! I'm your ShowHome training assistant. Ask me anything about installations, product specs, customer objections, troubleshooting, or company policies.</p>
          <p style="margin-top:0.6rem;color:#888;font-size:0.82rem">Choose a topic on the left or type your own question below.</p>
        </div>
      </div>
    </div>

    <!-- Input -->
    <div class="input-area">
      <div class="input-wrap">
        <textarea
          id="chatInput"
          class="chat-input"
          placeholder="Ask anything about ShowHome installations, products, or customer questions…"
          rows="1"
          autocomplete="off"
        ></textarea>
        <button id="sendBtn" class="send-btn" disabled aria-label="Send">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
        </button>
      </div>
      <p class="input-hint">Powered by Claude AI · For internal use only</p>
    </div>
  </main>

</div>

<script>
  // ── Auth guard ───────────────────────────────────────────────────
  const authed = sessionStorage.getItem('telStaffAuthed') === 'true';
  const pw     = sessionStorage.getItem('telStaffPw') ?? '';
  if (!authed || !pw) window.location.replace('/staff');

  // ── Logout ───────────────────────────────────────────────────────
  document.getElementById('logoutBtn').addEventListener('click', () => {
    sessionStorage.removeItem('telStaffAuthed');
    sessionStorage.removeItem('telStaffPw');
    window.location.replace('/staff');
  });

  // ── Conversation state ───────────────────────────────────────────
  let history = []; // [{role: 'user'|'assistant', content: string}]

  // ── DOM refs ─────────────────────────────────────────────────────
  const messagesEl = document.getElementById('messages');
  const inputEl    = document.getElementById('chatInput');
  const sendBtn    = document.getElementById('sendBtn');

  // ── Auto-resize textarea ─────────────────────────────────────────
  inputEl.addEventListener('input', () => {
    inputEl.style.height = 'auto';
    inputEl.style.height = Math.min(inputEl.scrollHeight, 160) + 'px';
    sendBtn.disabled = inputEl.value.trim().length === 0;
  });

  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      if (!sendBtn.disabled) send();
    }
  });

  sendBtn.addEventListener('click', send);

  // ── Topic quick-select ───────────────────────────────────────────
  document.querySelectorAll('.topic-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const q = btn.dataset.q;
      if (q) {
        inputEl.value = q;
        inputEl.dispatchEvent(new Event('input'));
        send();
      }
    });
  });

  // ── Clear / new conversation ─────────────────────────────────────
  document.getElementById('clearBtn').addEventListener('click', () => {
    history = [];
    messagesEl.innerHTML = `
      <div class="msg msg-ai">
        <div class="msg-avatar ai-avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
        </div>
        <div class="msg-bubble">
          <p>Conversation cleared. What do you need help with?</p>
        </div>
      </div>`;
  });

  // ── Send message ─────────────────────────────────────────────────
  async function send() {
    const text = inputEl.value.trim();
    if (!text) return;

    // Add user message
    appendMessage('user', text);
    history.push({ role: 'user', content: text });

    // Clear input
    inputEl.value = '';
    inputEl.style.height = 'auto';
    sendBtn.disabled = true;

    // Typing indicator
    const typingId = appendTyping();

    try {
      const res = await fetch('/.netlify/functions/staff-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history, password: pw }),
      });

      const data = await res.json();
      removeTyping(typingId);

      if (res.status === 401) {
        sessionStorage.clear();
        window.location.replace('/staff');
        return;
      }

      const reply = data.reply ?? data.error ?? 'Sorry, something went wrong. Please try again.';
      appendMessage('ai', reply);
      history.push({ role: 'assistant', content: reply });

    } catch {
      removeTyping(typingId);
      appendMessage('ai', 'Connection error — please check your internet and try again.');
    }
  }

  // ── Render helpers ────────────────────────────────────────────────
  function appendMessage(role, text) {
    const div = document.createElement('div');
    div.className = `msg msg-${role}`;

    if (role === 'ai') {
      div.innerHTML = `
        <div class="msg-avatar ai-avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
        </div>
        <div class="msg-bubble">${formatText(text)}</div>`;
    } else {
      div.innerHTML = `
        <div class="msg-bubble user-bubble">${escapeHtml(text)}</div>
        <div class="msg-avatar user-avatar">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
        </div>`;
    }

    messagesEl.appendChild(div);
    scrollToBottom();
    return div;
  }

  let typingCounter = 0;
  function appendTyping() {
    const id  = 'typing-' + (++typingCounter);
    const div = document.createElement('div');
    div.id        = id;
    div.className = 'msg msg-ai';
    div.innerHTML = `
      <div class="msg-avatar ai-avatar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
      </div>
      <div class="msg-bubble typing-bubble">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      </div>`;
    messagesEl.appendChild(div);
    scrollToBottom();
    return id;
  }

  function removeTyping(id) {
    document.getElementById(id)?.remove();
  }

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  // Convert newlines and markdown-lite to HTML
  function formatText(text) {
    return text
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      // Bullet points
      .replace(/^[•\-]\s+(.+)$/gm, '<li>$1</li>')
      .replace(/(<li>.*<\/li>)/s, '<ul>$1</ul>')
      // Numbered lists
      .replace(/^\d+\.\s+(.+)$/gm, '<li>$1</li>')
      // Headers (lines starting with ─ or ALL CAPS followed by newline)
      .replace(/^─+.*─+$/gm, '<hr class="divider">')
      .replace(/\n{2,}/g, '</p><p>')
      .replace(/\n/g, '<br>')
      .replace(/^/, '<p>').replace(/$/, '</p>')
      .replace(/<p><\/p>/g, '');
  }

  function escapeHtml(text) {
    return text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: #080808;
    color: #e8e8e8;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ── Top bar ──────────────────────────────────────────── */
  .topbar {
    background: #0e0e14;
    border-bottom: 1px solid #1e1e28;
    flex-shrink: 0;
    z-index: 10;
  }
  .topbar-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .topbar-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .topbar-logo {
    height: 40px;
    width: auto;
    filter: brightness(1.7);
    flex-shrink: 0;
  }
  .topbar-title {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .topbar-company {
    font-size: 0.78rem;
    font-weight: 600;
    color: #c8a000;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .topbar-portal {
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
  }
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .online-pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: #4CAF50;
    font-weight: 600;
    background: rgba(76,175,80,0.1);
    border: 1px solid rgba(76,175,80,0.25);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .online-dot {
    width: 6px;
    height: 6px;
    background: #4CAF50;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; } 50% { opacity: 0.4; }
  }
  .logout-btn {
    background: transparent;
    border: 1px solid #2a2a36;
    border-radius: 6px;
    color: #888;
    font-size: 0.78rem;
    font-family: inherit;
    padding: 5px 12px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .logout-btn:hover { border-color: #555; color: #ccc; }

  /* ── Layout ───────────────────────────────────────────── */
  .layout {
    display: flex;
    flex: 1;
    min-height: 0;
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
  }

  /* ── Sidebar ──────────────────────────────────────────── */
  .sidebar {
    width: 220px;
    flex-shrink: 0;
    background: #0c0c10;
    border-right: 1px solid #1a1a24;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 0.75rem 1rem;
    overflow-y: auto;
    gap: 0;
  }
  .sidebar-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #444;
    padding: 0 0.25rem;
    margin-bottom: 0.65rem;
  }
  .topic-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }
  .topic-btn {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #888;
    font-size: 0.78rem;
    font-family: inherit;
    text-align: left;
    padding: 0.45rem 0.65rem;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    line-height: 1.4;
  }
  .topic-btn:hover {
    background: #18181e;
    color: #ddd;
  }
  .sidebar-footer {
    padding-top: 1rem;
    border-top: 1px solid #1a1a24;
    margin-top: 0.5rem;
  }
  .clear-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    color: #555;
    font-size: 0.75rem;
    font-family: inherit;
    padding: 0.35rem 0.5rem;
    cursor: pointer;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
    width: 100%;
  }
  .clear-btn:hover { color: #aaa; background: #18181e; }

  /* ── Chat main ────────────────────────────────────────── */
  .chat-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .messages {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem 1.5rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    scroll-behavior: smooth;
  }

  /* ── Message bubbles ──────────────────────────────────── */
  .msg {
    display: flex;
    gap: 0.75rem;
    max-width: 800px;
    align-items: flex-start;
  }
  .msg-ai  { align-self: flex-start; }
  .msg-user {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .msg-avatar {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .ai-avatar {
    background: linear-gradient(135deg, #1a1a2e, #2a2a40);
    border: 1px solid #2e2e44;
    color: #c8a000;
  }
  .user-avatar {
    background: #1e1e28;
    border: 1px solid #2a2a38;
    color: #888;
  }

  .msg-bubble {
    background: #111118;
    border: 1px solid #1e1e2a;
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-size: 0.88rem;
    line-height: 1.65;
    color: #d8d8e8;
    max-width: calc(100% - 44px);
  }
  .msg-bubble p + p { margin-top: 0.5rem; }
  .msg-bubble ul { padding-left: 1.2rem; margin: 0.4rem 0; }
  .msg-bubble li { margin-bottom: 0.25rem; }
  .msg-bubble strong { color: #f0f0f0; font-weight: 600; }
  .msg-bubble .divider { border: none; border-top: 1px solid #2a2a36; margin: 0.6rem 0; }

  .user-bubble {
    background: #1a1a2e;
    border-color: #2a2a44;
    color: #e0e0f0;
  }

  /* Typing dots */
  .typing-bubble {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0.85rem 1rem;
  }
  .dot {
    width: 7px;
    height: 7px;
    background: #444;
    border-radius: 50%;
    animation: blink 1.2s infinite;
  }
  .dot:nth-child(2) { animation-delay: 0.2s; }
  .dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes blink {
    0%, 100% { opacity: 0.3; transform: scale(0.85); }
    50%       { opacity: 1;   transform: scale(1.1); }
  }

  /* ── Input area ───────────────────────────────────────── */
  .input-area {
    border-top: 1px solid #1a1a24;
    padding: 1rem 1.5rem 1.25rem;
    background: #0a0a0e;
    flex-shrink: 0;
  }
  .input-wrap {
    display: flex;
    align-items: flex-end;
    gap: 0.65rem;
    background: #111118;
    border: 1px solid #22222e;
    border-radius: 12px;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
    transition: border-color 0.2s;
  }
  .input-wrap:focus-within { border-color: #c8a000; }
  .chat-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #e8e8e8;
    font-size: 0.9rem;
    font-family: inherit;
    line-height: 1.5;
    resize: none;
    max-height: 160px;
    overflow-y: auto;
  }
  .chat-input::placeholder { color: #3a3a48; }
  .send-btn {
    width: 36px;
    height: 36px;
    background: #c8a000;
    border: none;
    border-radius: 8px;
    color: #000;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s, opacity 0.2s;
  }
  .send-btn:hover:not(:disabled) { background: #d4ae10; }
  .send-btn:disabled { opacity: 0.35; cursor: not-allowed; }

  .input-hint {
    font-size: 0.7rem;
    color: #333;
    text-align: center;
    margin-top: 0.55rem;
  }

  /* ── Responsive: hide sidebar on mobile ───────────────── */
  @media (max-width: 640px) {
    .sidebar { display: none; }
    .messages { padding: 1rem 1rem 0.5rem; }
    .input-area { padding: 0.75rem 1rem 1rem; }
    .topbar-company { display: none; }
  }
</style>

</body>
</html>
