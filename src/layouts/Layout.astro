---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Teton Exterior Lighting installs permanent LED lighting for homes across Idaho Falls, Jackson Hole, and the surrounding region. 3× brighter than DIY, 20–30 year lifespan, fully app-controlled.',
  ogImage = '/images/og-image.jpg',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Teton Exterior Lighting',
  description: 'Permanent LED exterior lighting installation based in Idaho Falls, ID. Serving Southeast Idaho, Jackson Hole WY, and the surrounding region.',
  telephone: '+12085579009',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Idaho Falls',
    addressRegion: 'ID',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'City', name: 'Idaho Falls', containedInPlace: { '@type': 'State', name: 'Idaho' } },
    { '@type': 'City', name: 'Jackson Hole', containedInPlace: { '@type': 'State', name: 'Wyoming' } },
    { '@type': 'City', name: 'Pocatello', containedInPlace: { '@type': 'State', name: 'Idaho' } },
    { '@type': 'City', name: 'Rexburg', containedInPlace: { '@type': 'State', name: 'Idaho' } },
    { '@type': 'City', name: 'Rigby', containedInPlace: { '@type': 'State', name: 'Idaho' } },
    { '@type': 'City', name: 'Twin Falls', containedInPlace: { '@type': 'State', name: 'Idaho' } },
  ],
  url: 'https://tetonexteriorlighting.com',
  image: 'https://tetonexteriorlighting.com/images/logo.png',
  sameAs: [
    'https://www.facebook.com/profile.php?id=61582526130774',
    'https://www.google.com/maps?cid=8379863443859849851',
    'https://www.instagram.com/tetonexteriorlighting/',
    'https://www.youtube.com/@TetonExteriorLighting',
  ],
  priceRange: '$$',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    bestRating: '5',
    reviewCount: '46',
  },
  review: [
    {
      '@type': 'Review',
      author: { '@type': 'Person', name: 'Mantis Sebastian' },
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      reviewBody: "Teton Exterior Lighting did an outstanding job on our home. The permanent lighting system they installed looks clean, professional, and completely transformed the exterior. The track is low-profile and blends in perfectly with the house, so it doesn't look bulky or out of place at all. What really sets it apart is the app controlled setup. It's incredibly easy to use and gives you full control over colors, brightness, and scheduling.",
    },
    {
      '@type': 'Review',
      author: { '@type': 'Person', name: 'Mark Bodily' },
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      reviewBody: 'Awesome lighting. Service is top notch! They have a great product and are extremely knowledgeable and customer oriented. Jayden was terrific to work with. I highly recommend!!!',
    },
    {
      '@type': 'Review',
      author: { '@type': 'Person', name: 'Jennifer Hewit' },
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      reviewBody: "Highly recommend Teton Exterior Lighting! He made sure we were getting the highest quality product, took us through a demo of the app, made sure they were installed properly and that we're are happy. He is very easy to work with. His professionalism and results are unsurpassed!",
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={new URL(ogImage, Astro.site)} />
  <meta property="og:site_name"   content="Teton Exterior Lighting" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={new URL(ogImage, Astro.site)} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/logo.png" />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <slot />

  <script>
    // Scroll reveal
    const observer = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</body>
</html>
